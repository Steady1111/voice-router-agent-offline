#!/bin/sh /etc/rc.common
# OpenWrt procd init for Voice Router Lite (ALSA + 分时模型 + ubus)

START=99
STOP=10

USE_PROCD=1
VOICE_ROOT=/opt/voice_router

start_service() {
	procd_open_instance
	procd_set_param command python3 -m voice_router_lite router
	procd_append_param command --config "$VOICE_ROOT/deploy/openwrt/voice-router.json"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param nice 10
	procd_set_param limits core="0"
	procd_set_param env VOICE_ROUTER_MODELS_DIR="$VOICE_ROOT/models"
	procd_close_instance
}

stop_service() {
	:
}
